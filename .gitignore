.venv/
data/*.db
data/*.db.bak*
data/*.bak*

# V10-00d 迁移前自动备份（含生产数据，绝不入库）
data/*.pre-migrate-*
data/*.db.tmp
data/raw/

# W01：SQLite 启用 WAL 后的旁文件（运行时产物，可能含未 checkpoint 的数据，绝不入库）
data/*.db-wal
data/*.db-shm

# W01：手工/脚本备份目录（含生产数据副本，绝不入库）
data/backups/
__pycache__/
*.pyc
.env
双色球预测系统方案.md

# 运行时数据（含密钥与训练产物，禁止入库）
data/llm_config.json
data/adaptive_state.json
# V12 CPU 治理：进化幂等闸门状态（记录「已进化到哪一期」，属运行时状态）
data/evolution_state.json
# 推理型模型学到的可用输出预算（运行时状态，随机器/模型而异）
data/llm_budget.json

# 本机生成、提交 GitHub 供 BF.US 导入的可审计挖掘产物
!data/mining_artifact.json
data/ml_models/
data/methods_config.json

# V5 自进化：假说库是**运行时状态**（每轮进化都会改写），不得入库
data/hypotheses.json

# V6 规律工坊：LLM 规律 + 每次运行的判定结果是**运行时状态**，不得入库
data/llm_claims.json

# V7 规律运行时快照（派生数据，由 /api/rules/refresh 或调度器重建）
data/patterns_runtime.json

# V12-16：自证实验的零分布缓存（**确定性**派生数据，可由 seed 重算；
# 缓存只为把首次约 5.6s 的计算挪到启动后台，丢失只影响速度、不影响结果）
data/selfcheck_null_cache.json
# D-3：ML 诊断结果缓存（运行时状态，可重算）
data/ml_diag_cache.json
data/ml_diag_cache.json.tmp
data/rule_lifecycle.json
data/rule_lifecycle.json.tmp
# MU-2：每用户 API Key 的主密钥（若落盘而非走 env）。**绝不能进仓库。**
data/.secret_key
# 追加型运行日志（内容随每次调用增长，不属于源码）
data/llm_cost_log.jsonl
# V13 P1a：归档的废弃数据文件（保留可恢复，不进版本库）
data/archive/

# P4 闲时挖掘断点（运行时状态：游标、判定计数、可用候选，且会随挖掘推进持续变化）
data/idle_mining_state.json
data/idle_mining_state.json.tmp
.git-safety/
data/popularity_model.json
